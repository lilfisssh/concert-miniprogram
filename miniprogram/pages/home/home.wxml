<!-- 首页：全屏水墨循环视频 + DOM 叠字（叠字不烧进视频） -->
<view class="home" style="padding-top: {{statusBarHeight}}px">
  <!-- 兜底静帧：首帧即刻可见，视频失败时兜底 -->
  <image class="bg-fallback" src="/assets/hero/hero_clean.jpg" mode="aspectFill" aria-hidden="true" />
  <!-- 主视觉：循环视频，首帧就绪后淡入；onReady/onShow 里用 VideoContext 主动 play -->
  <video id="bgVideo" class="bg-video {{videoReady ? 'is-on' : ''}}"
    src="/assets/hero/hero_loop_clean.mp4"
    autoplay muted loop
    object-fit="cover"
    controls="{{false}}"
    show-play-btn="{{false}}"
    show-center-play-btn="{{false}}"
    show-fullscreen-btn="{{false}}"
    show-mute-btn="{{false}}"
    enable-progress-gesture="{{false}}"
    enable-play-gesture="{{false}}"
    bindloadeddata="onVideoReady" />

  <view class="home-ui">
    <!-- 顶部字群：WELFARE CONCERT / 忆诗声予你 / 细线 / 时间地点 -->
    <view class="hero-copy">
      <view class="eyebrow">WELFARE CONCERT</view>
      <view class="title-zh">忆诗声予你</view>
      <view class="rule"></view>
      <view class="meta">2026.08.10 18:00&nbsp;&nbsp;智慧山 · 飞鸟剧场</view>
    </view>

    <view class="spacer"></view>

    <!-- 中下 CTA -->
    <view class="cta-wrap">
      <button class="cta" bindtap="goBuy" aria-label="立即购票">立即购票<text class="en">Buy Tickets</text></button>
    </view>

    <!-- 底链：活动介绍 / 我的订单 / 我的 -->
    <view class="entry-links">
      <button class="link" bindtap="goAbout" aria-label="活动介绍">
        <text class="zh">活动介绍</text><text class="en">About</text>
      </button>
      <button class="link" bindtap="goMe" aria-label="我的订单">
        <text class="zh">我的订单</text><text class="en">My Orders</text>
      </button>
      <button class="link" bindtap="goMe" aria-label="我的">
        <text class="zh">我的</text><text class="en">Me</text>
      </button>
    </view>
  </view>
</view>
