.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 舞台 */
.stage {
  margin: 16rpx auto 8rpx;
  width: 70%;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: #333;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  background: linear-gradient(#ffe14d, #ffd400);
  border-radius: 8rpx;
}

/* 票档提示 */
.ticket-banner {
  margin: 4rpx 16rpx;
  padding: 12rpx 16rpx;
  background: #eef5ff;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #2b6cb0;
  text-align: center;
}
.ticket-banner .zone-name {
  font-weight: bold;
}

/* 图例 */
.legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 8rpx 12rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  margin: 4rpx 12rpx;
}
.legend-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
}
.legend-txt {
  font-size: 22rpx;
  color: #555;
}

/* 画布 */
.canvas-wrap {
  position: relative;
  flex: 1;
  margin: 0 8rpx;
  background: #fff;
  border-radius: 8rpx;
  overflow: hidden;
}
.seat-canvas {
  width: 100%;
  height: 100%;
}
.loading {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

/* 缩放按钮 */
.zoom-controls {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  flex-direction: column;
}
.zoom-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  margin-top: 12rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 36rpx;
  border-radius: 50%;
}

/* 底部栏 */
.bottombar {
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
}
.selected-line {
  font-size: 26rpx;
  color: #333;
  min-height: 36rpx;
  line-height: 36rpx;
}
.action-line {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.total {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #e8543e;
}
.confirm {
  width: 240rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
}
