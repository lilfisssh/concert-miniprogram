.page {
  padding: 32rpx;
}
.hero {
  padding: 48rpx 8rpx 24rpx;
}
.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #222;
}
.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #888;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}
.field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.label {
  font-size: 24rpx;
  color: #999;
}
.input {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #333;
  height: 56rpx;
}
.verify-btn {
  margin-top: 32rpx;
  width: 100%;
  border-radius: 44rpx;
  font-size: 32rpx;
}
.tips {
  margin-top: 40rpx;
  padding: 8rpx;
}
.tip-title {
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.tip-line {
  font-size: 24rpx;
  color: #999;
  line-height: 40rpx;
}
.demo {
  margin-top: 40rpx;
  padding: 16rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #ad6800;
  line-height: 36rpx;
}
